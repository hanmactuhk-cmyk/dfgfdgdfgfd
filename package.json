{
  "name": "hoai-videoai-automation",
  "version": "1.0.1",
  "description": "Hoai VideoAi Automation - Google Flow image/video automation desktop app",
  "main": "main.js",
  "author": "Hoai",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "dependencies": {
    "playwright-core": "^1.55.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.hoai.videoai.automation",
    "productName": "Hoai VideoAi Automation",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "automation/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      "data/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": null
  }
}
